{
  "appId": "com.basobaso.agroplanner",
  "appName": "Agro Planner",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#F59E0B",
      "sound": "beep.wav"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#FAF7F2",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
