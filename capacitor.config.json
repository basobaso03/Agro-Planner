{
  "appId": "com.basobaso.agroplanner",
  "appName": "CapitaSeed",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#F59E0B"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#FAF7F2",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
    "Keyboard": {
      "resize": "none",
      "style": "light",
      "resizeOnFullScreen": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FAF8F5"
    }
  }
}