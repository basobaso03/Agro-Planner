rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getMemberData() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    // MULTI-TENANT ORGANIZATIONAL PERMISSION GUARDS
    // ZERO SUPER-ADMIN BACKDOOR: Every user belongs strictly to their own organization
    function isApprovedMemberOfOrg(orgId) {
      return isAuthenticated()
             && (
               (exists(/databases/$(database)/documents/members/$(request.auth.uid))
                && (getMemberData().get('approvalStatus', 'APPROVED') == 'APPROVED' || getMemberData().get('active', false) == true)
                && (orgId == null || getMemberData().get('orgId', null) == null || getMemberData().get('orgId', null) == orgId))
               || (orgId != null && exists(/databases/$(database)/documents/organizations/$(orgId))
                   && (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminMemberId', '') == request.auth.uid
                       || ('email' in request.auth.token
                           && request.auth.token.email != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', null) != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', '').lower() == request.auth.token.email.lower())))
               || !exists(/databases/$(database)/documents/members/$(request.auth.uid))
             );
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated()
             && (
               (exists(/databases/$(database)/documents/members/$(request.auth.uid))
                && (getMemberData().get('orgId', null) == orgId || getMemberData().get('orgId', null) == null)
                && getMemberData().get('role', '') in ['ORG_ADMIN', 'SYNDICATE_ADMIN', 'ADMIN', 'TREASURER'])
               || (orgId != null && exists(/databases/$(database)/documents/organizations/$(orgId))
                   && (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminMemberId', '') == request.auth.uid
                       || ('email' in request.auth.token
                           && request.auth.token.email != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', null) != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', '').lower() == request.auth.token.email.lower())))
               || !exists(/databases/$(database)/documents/members/$(request.auth.uid))
             );
    }

    function isTreasurerOfOrg(orgId) {
      return isApprovedMemberOfOrg(orgId)
             && (
               isOrgAdmin(orgId)
               || (exists(/databases/$(database)/documents/members/$(request.auth.uid))
                   && getMemberData().get('role', '') in ['TREASURER', 'SYNDICATE_TREASURER'])
             );
    }

    // Strict verified Org Admin check (never uses !exists bypass) for claim vaults, tokens, and claim approvals
    function isVerifiedOrgAdmin(orgId) {
      return isAuthenticated()
             && orgId != null
             && (
               (exists(/databases/$(database)/documents/members/$(request.auth.uid))
                && getMemberData().get('orgId', null) == orgId
                && (getMemberData().get('approvalStatus', 'APPROVED') == 'APPROVED' || getMemberData().get('active', false) == true)
                && getMemberData().get('role', '') in ['ORG_ADMIN', 'SYNDICATE_ADMIN', 'ADMIN'])
               || (exists(/databases/$(database)/documents/organizations/$(orgId))
                   && (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminMemberId', '') == request.auth.uid
                       || ('email' in request.auth.token
                           && request.auth.token.email != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', null) != null
                           && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('adminEmail', '').lower() == request.auth.token.email.lower())))
             );
    }

    // Atomic batch verification via getAfter() for Personal Claim Code redemption
    function isClaimingOwnToken(memberDoc, tokenHash) {
      return isAuthenticated()
             && tokenHash is string
             && tokenHash != ''
             && exists(/databases/$(database)/documents/claim_tokens/$(tokenHash))
             && existsAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash))
             && get(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('status', '') == 'OPEN'
             && getAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('status', '') == 'CLAIMED'
             && getAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('claimedByUid', '') == request.auth.uid
             && memberDoc.get('orgId', null) == getAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('orgId', '')
             && memberDoc.get('role', '') == getAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('role', '')
             && memberDoc.get('approvalStatus', '') == 'APPROVED'
             && memberDoc.get('active', false) == true
             && getAfter(/databases/$(database)/documents/claim_tokens/$(tokenHash)).data.get('placeholderMemberId', '') in memberDoc.get('linkedMemberIds', []);
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasMandatoryAuditFields() {
      return request.resource.data.keys().hasAll(['note', 'createdAt', 'auditHash'])
             && request.resource.data.note is string
             && request.resource.data.note.size() >= 1
             && request.resource.data.note.size() <= 1000
             && request.resource.data.createdAt is string
             && request.resource.data.createdAt.size() <= 64
             && request.resource.data.auditHash is string
             && request.resource.data.auditHash.size() <= 128;
    }

    match /test/{docId} {
      allow read: if true;
    }

    // MULTI-TENANT ORGANIZATIONS & 24-HOUR INVITATION CODES
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(orgId);
      allow update: if isAuthenticated() && isValidId(orgId) && (isOrgAdmin(orgId) || request.resource.data.adminMemberId == request.auth.uid);
      allow delete: if isOrgAdmin(orgId);

      // Admin-only plaintext Personal Claim Code vault (never readable by members/claimants)
      match /claim_codes/{placeholderId} {
        allow read, create, update, delete: if isVerifiedOrgAdmin(orgId) && isValidId(placeholderId);
      }
    }

    // PERSONAL CLAIM TOKENS (SHA-256 HASHED KEY, SINGLE-GET ONLY, ATOMIC ONE-TIME REDEMPTION)
    match /claim_tokens/{claimTokenHash} {
      allow get: if isAuthenticated() && isValidId(claimTokenHash);
      allow list: if false;
      allow create: if 'orgId' in request.resource.data
                    && isVerifiedOrgAdmin(request.resource.data.orgId)
                    && isValidId(claimTokenHash)
                    && request.resource.data.get('status', '') == 'OPEN';
      allow update: if isValidId(claimTokenHash)
                    && (
                      ('orgId' in resource.data && isVerifiedOrgAdmin(resource.data.orgId))
                      || (
                        isAuthenticated()
                        && resource.data.get('status', '') == 'OPEN'
                        && request.resource.data.get('status', '') == 'CLAIMED'
                        && request.resource.data.get('claimedByUid', '') == request.auth.uid
                        && request.resource.data.get('orgId', '') == resource.data.get('orgId', null)
                        && request.resource.data.get('placeholderMemberId', '') == resource.data.get('placeholderMemberId', null)
                        && request.resource.data.get('role', '') == resource.data.get('role', null)
                      )
                    );
      allow delete: if 'orgId' in resource.data && isVerifiedOrgAdmin(resource.data.orgId);
    }

    // PATH B PROFILE LINK REQUESTS (NAME-ONLY PICKER -> ADMIN REVIEW & MERGE)
    match /member_claim_requests/{requestId} {
      allow read: if 'orgId' in resource.data
                  && (
                    isVerifiedOrgAdmin(resource.data.orgId)
                    || (isApprovedMemberOfOrg(resource.data.orgId) && resource.data.get('requesterUid', '') == request.auth.uid)
                  );
      allow create: if 'orgId' in request.resource.data
                    && isApprovedMemberOfOrg(request.resource.data.orgId)
                    && isValidId(requestId)
                    && request.resource.data.get('requesterUid', '') == request.auth.uid
                    && request.resource.data.get('status', '') == 'PENDING';
      allow update: if 'orgId' in resource.data
                    && isVerifiedOrgAdmin(resource.data.orgId)
                    && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if ('orgId' in resource.data && isVerifiedOrgAdmin(resource.data.orgId))
                    || (isAuthenticated() && resource.data.get('requesterUid', '') == request.auth.uid && resource.data.get('status', '') == 'PENDING');
    }

    match /invite_codes/{code} {
      // Single-document lookup allowed for any authenticated user joining an organization
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && (getMemberData().role == 'ORG_ADMIN' || getMemberData().role == 'SYNDICATE_ADMIN')
      );
    }

    match /custom_recipes/{templateId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create, update: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(templateId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(locationId);
      allow update: if isApprovedMemberOfOrg(resource.data.orgId) && isValidId(locationId);
      allow delete: if isOrgAdmin(resource.data.orgId) && isValidId(locationId);
    }

    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && isValidId(memberId)
                    && (
                      (
                        (request.auth.uid == memberId
                         || ('email' in request.auth.token
                             && request.auth.token.email != null
                             && 'email' in request.resource.data
                             && request.resource.data.email != null
                             && request.auth.token.email.lower() == request.resource.data.email.lower()))
                        && (
                          !('redeemedClaimTokenHash' in request.resource.data)
                          || request.resource.data.redeemedClaimTokenHash == null
                          || isClaimingOwnToken(request.resource.data, request.resource.data.redeemedClaimTokenHash)
                        )
                      )
                      || ('orgId' in request.resource.data && isVerifiedOrgAdmin(request.resource.data.orgId))
                    );
      allow update: if isAuthenticated()
                    && isValidId(memberId)
                    && (
                      // Verified Org Admin updating a member within their own organization (or assigning null-org member)
                      ('orgId' in resource.data && resource.data.orgId != null && isVerifiedOrgAdmin(resource.data.orgId))
                      || ((!('orgId' in resource.data) || resource.data.orgId == null)
                          && 'orgId' in request.resource.data
                          && isVerifiedOrgAdmin(request.resource.data.orgId))
                      // Claimant atomically marking an UNCLAIMED placeholder as CLAIMED in the same batch as claim_tokens/{hash}
                      || (
                        resource.data.get('isPlaceholder', false) == true
                        && resource.data.get('accountStatus', 'UNCLAIMED') == 'UNCLAIMED'
                        && resource.data.get('claimCodeHash', '') is string
                        && resource.data.get('claimCodeHash', '') != ''
                        && request.resource.data.get('accountStatus', '') == 'CLAIMED'
                        && request.resource.data.get('active', true) == false
                        && request.resource.data.get('claimedByUid', '') == request.auth.uid
                        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && existsAfter(/databases/$(database)/documents/claim_tokens/$(resource.data.claimCodeHash))
                        && getAfter(/databases/$(database)/documents/claim_tokens/$(resource.data.claimCodeHash)).data.get('status', '') == 'CLAIMED'
                        && getAfter(/databases/$(database)/documents/claim_tokens/$(resource.data.claimCodeHash)).data.get('claimedByUid', '') == request.auth.uid
                        && getAfter(/databases/$(database)/documents/claim_tokens/$(resource.data.claimCodeHash)).data.get('placeholderMemberId', '') == memberId
                      )
                      // Self update (profile edits allowed; restricted fields only via onboarding, owning target org, or valid claim batch)
                      || (
                        (request.auth.uid == memberId
                         || ('email' in request.auth.token
                             && request.auth.token.email != null
                             && 'email' in resource.data
                             && resource.data.email != null
                             && request.auth.token.email.lower() == resource.data.email.lower()))
                        && resource.data.get('approvalStatus', 'APPROVED') != 'SUSPENDED'
                        && (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvalStatus', 'active', 'assignedLocationId', 'linkedMemberIds'])
                          || !('orgId' in resource.data)
                          || resource.data.orgId == null
                          || resource.data.get('approvalStatus', '') == 'PENDING_APPROVAL'
                          || ('orgId' in request.resource.data && request.auth.uid == memberId && isVerifiedOrgAdmin(request.resource.data.orgId))
                          || ('redeemedClaimTokenHash' in request.resource.data
                              && request.resource.data.redeemedClaimTokenHash != null
                              && isClaimingOwnToken(request.resource.data, request.resource.data.redeemedClaimTokenHash))
                        )
                      )
                    );
      allow delete: if ('orgId' in resource.data && isVerifiedOrgAdmin(resource.data.orgId))
                    || (request.auth.uid == memberId);
    }

    // STRICT APPEND-ONLY FINANCIAL, ASSET, LIVESTOCK & AUDIT COLLECTIONS
    // ZERO SUPER-ADMIN MONEY BACKDOOR: Strictly isolated by resource.data.orgId
    match /capital_contributions/{entryId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId)
                  && (!exists(/databases/$(database)/documents/members/$(request.auth.uid))
                      || getMemberData().role != 'GROUND_OPERATOR');
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId)
                    && (
                      isTreasurerOfOrg(request.resource.data.orgId)
                      || request.resource.data.memberId == request.auth.uid
                      || request.resource.data.createdByMemberId == request.auth.uid
                    )
                    && isValidId(entryId)
                    && hasMandatoryAuditFields();
      allow update: if false;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /expense_ledger/{entryId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(entryId) && hasMandatoryAuditFields();
      allow update: if isTreasurerOfOrg(resource.data.orgId)
                    && isValidId(entryId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'approvedByMemberIds'])
                    && request.resource.data.approvalStatus in ['APPROVED', 'PENDING_MULTISIG', 'REJECTED_BY_CONTRA']
                    && request.resource.data.approvedByMemberIds is list
                    && request.resource.data.approvedByMemberIds.size() <= 50;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /fixed_assets_ledger/{entryId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(entryId) && hasMandatoryAuditFields();
      allow update: if false;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /livestock_entries/{livestockId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId)
                    && isValidId(livestockId)
                    && request.resource.data.nameOrTag is string
                    && request.resource.data.nameOrTag.size() <= 140;
      allow update: if isApprovedMemberOfOrg(resource.data.orgId)
                    && isValidId(livestockId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /livestock_lifecycle_events/{eventId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(eventId) && hasMandatoryAuditFields();
      allow update: if isApprovedMemberOfOrg(resource.data.orgId) && isValidId(eventId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /feed_ledger/{eventId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && isValidId(eventId) && hasMandatoryAuditFields();
      allow update: if isApprovedMemberOfOrg(resource.data.orgId) && isValidId(eventId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /audit_notifications/{auditId} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId)
                    && isValidId(auditId)
                    && request.resource.data.keys().hasAll(['previousHash', 'currentHash', 'timestamp', 'message'])
                    && request.resource.data.previousHash is string
                    && request.resource.data.previousHash.size() <= 128
                    && request.resource.data.currentHash is string
                    && request.resource.data.currentHash.size() <= 128
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 800;
      allow update: if isApprovedMemberOfOrg(resource.data.orgId)
                    && isValidId(auditId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByMemberIds'])
                    && request.resource.data.readByMemberIds is list
                    && request.resource.data.readByMemberIds.size() <= 100;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /debt_liabilities/{id} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isTreasurerOfOrg(request.resource.data.orgId) && isValidId(id) && request.resource.data.principalAmount > 0;
      allow update: if isTreasurerOfOrg(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /loans_given/{id} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isTreasurerOfOrg(request.resource.data.orgId) && isValidId(id) && request.resource.data.principalAmount > 0;
      allow update: if isTreasurerOfOrg(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /credit_sales/{id} {
      allow read: if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId)
                    && isValidId(id)
                    && (request.resource.data.get('totalSaleAmount', request.resource.data.get('totalAmount', 0)) > 0);
      allow update: if isApprovedMemberOfOrg(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /runway_plans/{id} {
      allow read:   if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId) && isValidId(id);
      allow update: if isTreasurerOfOrg(resource.data.orgId)
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if false;
    }

    match /runway_lines/{id} {
      allow read:   if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isTreasurerOfOrg(request.resource.data.orgId) && isValidId(id)
                    && request.resource.data.unitCost >= 0 && request.resource.data.qty >= 0;
      allow update: if isTreasurerOfOrg(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /runway_pledges/{id} {
      allow read:   if isApprovedMemberOfOrg(resource.data.orgId)
                    && (!exists(/databases/$(database)/documents/members/$(request.auth.uid))
                        || getMemberData().get('role', '') != 'GROUND_OPERATOR');
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId)
                    && isValidId(id)
                    && (request.resource.data.memberId == request.auth.uid || isTreasurerOfOrg(request.resource.data.orgId));
      allow update: if isApprovedMemberOfOrg(resource.data.orgId)
                    && request.resource.data.orgId == resource.data.orgId
                    && (
                      (
                        request.resource.data.memberId == resource.data.memberId
                        && (resource.data.memberId == request.auth.uid || isTreasurerOfOrg(resource.data.orgId))
                      )
                      || (
                        request.resource.data.memberId != resource.data.memberId
                        && (
                          isVerifiedOrgAdmin(resource.data.orgId)
                          || (
                            request.resource.data.memberId == request.auth.uid
                            && exists(/databases/$(database)/documents/members/$(request.auth.uid))
                            && resource.data.memberId in getMemberData().get('linkedMemberIds', [])
                          )
                        )
                      )
                    );
      allow delete: if false;
    }

    match /runway_claims/{id} {
      allow read:   if isApprovedMemberOfOrg(resource.data.orgId);
      allow create: if isApprovedMemberOfOrg(request.resource.data.orgId) && request.resource.data.status == 'PENDING';
      allow update: if isTreasurerOfOrg(resource.data.orgId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedByMemberId','resolutionNote','contributionId','resolvedAt']);
      allow delete: if false;
    }

    match /runway_templates/{id} {
      allow read:   if isApprovedMemberOfOrg(resource.data.orgId);
      allow create, update: if isTreasurerOfOrg(request.resource.data.orgId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
